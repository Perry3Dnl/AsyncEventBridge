<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AsyncEventBridge</AssemblyName>
    <RootNamespace>AsyncEventBridge</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageId>AsyncEventBridge</PackageId>
    <Authors>Perry3Dnl</Authors>
    <Description>Bridge event-driven and async .NET code in both directions on the stable .NET Standard 2.0 baseline.</Description>
    <PackageTags>async;events;task;iasyncenumerable;source-generator;netstandard;netstandard2.0</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/AsyncEventBridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/AsyncEventBridge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>assets/AsyncEventBridge.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AsyncEventBridge.Generators/AsyncEventBridge.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <None Include="../../README.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
    <None Include="../../assets/AsyncEventBridge.png"
          Pack="true"
          PackagePath="assets/"
          Visible="false" />
    <None Include="../AsyncEventBridge.Generators/bin/$(Configuration)/netstandard2.0/AsyncEventBridge.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
</Project>
