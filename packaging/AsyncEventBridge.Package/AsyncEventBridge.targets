<Project>
  <ItemGroup Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <Analyzer Include="$(MSBuildThisFileDirectory)..\tools\generators\modern\AsyncEventBridge.Generators.dll"
              Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <Analyzer Include="$(MSBuildThisFileDirectory)..\tools\generators\compat\AsyncEventBridge.Generators.dll"
              Visible="false" />
  </ItemGroup>
</Project>
