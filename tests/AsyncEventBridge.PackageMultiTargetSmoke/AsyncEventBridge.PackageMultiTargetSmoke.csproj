<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AsyncEventBridgePackageVersion Condition="'$(AsyncEventBridgePackageVersion)' == ''">$(Version)</AsyncEventBridgePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncEventBridge" Version="$(AsyncEventBridgePackageVersion)" />
  </ItemGroup>
</Project>
