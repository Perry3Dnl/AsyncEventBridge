<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AsyncEventBridge</AssemblyName>
    <RootNamespace>AsyncEventBridge</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>AsyncEventBridge</PackageId>
    <Authors>Perry3Dnl</Authors>
    <Description>Bridge event-driven and async .NET code in both directions. The complete minimum runtime contract remains .NET Standard 2.0, with a native .NET Standard 2.1 asset for modern runtimes and Unity.</Description>
    <PackageTags>async;events;task;iasyncenumerable;source-generator;netstandard;netstandard2.0;netstandard2.1</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/AsyncEventBridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/AsyncEventBridge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>assets/AsyncEventBridge.png</PackageIcon>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AsyncEventBridge.Generators/AsyncEventBridge.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <None Include="../../README.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
    <None Include="../../assets/AsyncEventBridge.png"
          Pack="true"
          PackagePath="assets/"
          Visible="false" />
    <None Include="../AsyncEventBridge.Generators/bin/$(Configuration)/netstandard2.0/AsyncEventBridge.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
</Project>
