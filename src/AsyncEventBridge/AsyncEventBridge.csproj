<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AsyncEventBridge</AssemblyName>
    <RootNamespace>AsyncEventBridge</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>AsyncEventBridge</PackageId>
    <Authors>Perry3Dnl</Authors>
    <Description>Bridge event-driven and async .NET code in both directions with a native modern .NET runtime.</Description>
    <PackageTags>async;events;task;valuetask;iasyncenumerable;channels;source-generator;net10</PackageTags>
    <PackageProjectUrl>https://github.com/Perry3Dnl/AsyncEventBridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/AsyncEventBridge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>assets/AsyncEventBridge.png</PackageIcon>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AsyncEventBridge.Generators/AsyncEventBridge.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <None Include="../../README.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
    <None Include="../../assets/AsyncEventBridge.png"
          Pack="true"
          PackagePath="assets/"
          Visible="false" />
    <None Include="../AsyncEventBridge.Generators/bin/$(Configuration)/netstandard2.0/AsyncEventBridge.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
</Project>
